        <Background state="pressed" sprite="TEXT_BUTTON_BG_DOWN_MID" />
        <Background state="disabled" sprite="TEXT_BUTTON_BG_MID" disabled="1" />
        <Text colour="black" align="center" />
    </Style>

    <Style name="ex_confederate_status_text" base="small_text">
        <Text colour="khaki" align="left" />
    </Style>
</ButtonStyles>
